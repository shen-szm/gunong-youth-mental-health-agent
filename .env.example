# 咕哝 v5 本地开发配置（不得提交真实密钥）
RELEASE_VERSION=5.1.0-alpha.5
DATABASE_URL=sqlite:///./shengyu_v5_dev.db
DEMO_MODE=true
COOKIE_SECURE=false
ALLOW_EXTERNAL_AI=false
ALLOW_GUARDIAN_SYNTHETIC_AI=true
BACKEND_PORT=9000

# 讯飞能力：留空时守护者方案会明确降级为审核模板。
SPARK_MODEL=pro
SPARK_API_PASSWORD=
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# 学生聊天「小满」：Key 只放服务端，不下发浏览器。
# platform_direct 会把对话原文发给 DeepSeek 生成回应和本次小结，运营方须先完成治理确认再开启。
STUDENT_COMPANION_ENGINE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ALLOW_STUDENT_EXTERNAL_AI=false
STUDENT_AI_ACCESS_MODE=teacher_authorized
PLATFORM_STUDENT_AI_GOVERNANCE_ACK=false

# 标准筛查（PHQ-9）：默认关闭；开启前需完成中文措辞与教师可见口径复核。
STUDENT_SCREENING_ENABLED=false

# 可选本地教师账号；密码必须至少12位。比赛守护者流程无需配置。
ADMIN_USERNAME=
ADMIN_PASSWORD=
