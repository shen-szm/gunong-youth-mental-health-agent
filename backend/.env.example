# 讯飞开放平台 https://console.xfyun.cn/
APP_ENV=development
DEMO_MODE=false
COOKIE_SECURE=false
ALLOW_EXTERNAL_AI=false
ALLOW_GUARDIAN_EXTERNAL_AI=false
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# 星火大模型配置
SPARK_API_PASSWORD=
SPARK_MODEL=pro

# 数据库连接。生产环境必须替换为独立数据库并配置备份、加密和最小权限账号。
DATABASE_URL=sqlite:///./gunong_dev.db

# 首位管理员必须由部署者在初始化时创建；仓库不提供默认账号或密码。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 后端服务端口
BACKEND_PORT=8000
